##################### Boosting #####################

nasdaq.train$High <- as.numeric(Y)
factor_vars <- names(which(sapply(nasdaq.train, is.factor)))
nasdaq.train$Date <- NULL
nasdaq.test$Date <- NULL

for (var in factor_vars) {
  nasdaq.test[[var]] <- factor(nasdaq.test[[var]], levels = levels(nasdaq.train[[var]]))
  levels_var <- levels(nasdaq.train[[var]])
  duplicated_levels <- levels_var[duplicated(levels_var)]
  
  if (length(duplicated_levels) > 0) {
    cat("Variable", var, "has duplicated levels:", duplicated_levels, "\n")
  }
}

# Define the shrinkage parameter
lambda <- seq(from = 0.01, to = 0.1, by = 0.01) # 10 steps from 0.01 to 0.1
boost.error <- matrix(nrow = length(lambda), ncol = 2)
colnames(boost.error) <- c("lambda", "Error Rate")

set.seed(10)
for (i in 1:length(lambda)){
  boosting <- gbm(High ~ ., data = nasdaq.train, distribution = "bernoulli", 
                  n.trees = 1000, interaction.depth = 1, shrinkage = lambda[i], 
                  verbose = FALSE)
  
  boosting.pred <- predict(boosting, nasdaq.test, n.trees = 1000, type = "response")
  boosting.pred <- ifelse(boosting.pred > 0.5, 1, 0)
  
  confusion <- table(boosting.pred, High.test)
  error <- 1 - (sum(diag(confusion)) / sum(confusion))  
  boost.error[i,] <- c(lambda[i], error)
}

boost.error

# Extract lambda and error values as numeric vectors
lambda.values <- as.numeric(boost.error[, 1])
error.values <- as.numeric(boost.error[, 2])

# Plot Test Error Rate vs. Lambda
plot(lambda.values, error.values, type = "b",
     xlab = "Lambda (Shrinkage Parameter)", ylab = "Test Error Rate",
     main = "Boosting: Test Error Rate vs. Lambda")

