##################### Response and Lag transformation ##################### 

columns <- c("Date", "Close", "Volume", "mom", "mom1", "mom2", "mom3", "ROC_10", "EMA_10", "DTB4WK", 
             "DTB3", "DTB6", "DGS5", "DGS10", "Oil", "Gold", "DAAA", "DBAA", "JPY", "CAD", "CNY", 
             "AAPL", "AMZN", "GE", "JNJ", "JPM", "MSFT", "WFC", "XOM", "FCHI", "FTSE", "GDAXI", 
             "GSPC", "HSI", "DJI", "SSEC", "RUT", "NYSE", "TE1", "TE2", "TE3", "DE1", "DE2", "CTB3M", 
             "CTB6M", "CTB1Y", "AUD", "Brent", "f.CAC", "f.copper", "oil", "f.DAX", "f.DJI", "EUR", 
             "f.FTSE", "f.gold", "f.HSI", "f.KOPSI", "f.NASDAQ", "f.GAS", "f.Nikkei", "NZD", 
             "f.silver", "f.RUSSEL", "f.SP", "CHF", "f.Dollar", "Dollar", "f.wheat", "XAG", "XAU")

# Assign new column names
colnames(nasdaq) <- columns   # 'f.' in column names indicates a future of the commodity

names(nasdaq) # Command verifies that the column names have been updated correctly

# This completes the initial data setup.


# List of columns to apply lag transformation
lag.columns <- columns[3:length(columns)]

# Apply lag transformation to specified columns
nasdaq[lag.columns] <- lapply(nasdaq[lag.columns], function(x) x - lag(x))

lm.fit <- lm(Close ~ ., nasdaq)

# High equals 1 if Close > previous Close; 0 otherwise
nasdaq$Close <- as.factor(ifelse(nasdaq$Close > lag(nasdaq$Close), 1, 0))
names(nasdaq)[names(nasdaq) == "Close"] <- "High"

# Remove the first row with NA values from lag transformation
nasdaq <- nasdaq[-1, ]

# Remove rows with any missing values
nasdaq <- na.omit(nasdaq)

# attach(nasdaq)

# Data is now ready for further analysis. 
# The cleaned data set has 970 observations down from 1972

##################### Classification w/ 16 predictors #####################

# Define feature sets
features <- data.frame(Volume, mom, mom1, mom2, mom3, ROC_10, EMA_10, DTB4WK, 
                       JNJ, GSPC, DJI, NYSE, f.DJI, f.GAS, f.Nikkei, f.SP)

predictors <- colnames(features)

# Split data into training and testing sets
split <- floor(0.5*nrow(nasdaq))
train <- c(1:split)
test <- c((split+1):nrow(nasdaq))

# Training and Testing Data
nasdaq.train <- nasdaq[train, ]
High.train <- nasdaq$High[train]
train.X = features[train, ]
nasdaq.test <- nasdaq[test, ]
High.test <- nasdaq$High[test]
test.X = features[test, ]

# Prepare for glm, lda, qda, tree
formula <- as.formula(paste("High ~", paste(predictors, collapse = "+")))

# Prepare for glmnet ie Ridge and Lasso
Xvars <- model.matrix(High ~ ., nasdaq.train)[, -1]  # Exclude the intercept
Y <- as.numeric(as.character(High.train))

# Scale training data by storing the scaling parameters
scaled_train <- scale(nasdaq.train[predictors])
train_center <- attr(scaled_train, "scaled:center")
train_scale <- attr(scaled_train, "scaled:scale")
nasdaq.train[predictors] <- scaled_train

# Scale test data using the training data's scaling parameters
nasdaq.test[predictors] <- scale(nasdaq.test[predictors], center = train_center, scale = train_scale)

# The data is now ready for model training and evaluation
# 485 observations will be used in the training data set leaving 485 for testing

##################### Ridge Logistic * #####################

# Fit Ridge logistic regression using ALL predictors *
ridge.mod <- glmnet(Xvars, Y, alpha = 0, family = "binomial")  # default = 10 folds

# Cross-validation to find the best lambda
set.seed(10)
cv.ridge <- cv.glmnet(Xvars, Y, alpha = 0, family = "binomial")
ridge.bestlam <- cv.ridge$lambda.min

par(mfrow = c(1, 1))
plot(ridge.mod, main="Ridge Trace", xlab="lambda", ylab="Cofficients")
plot(cv.ridge, main = "Ridge Regression")

# Predict on test data
Xvars.test <- model.matrix(High ~ ., nasdaq.test)[, -1]
ridge.prob <- predict(ridge.mod, s = ridge.bestlam, newx = Xvars.test, type = "response")

# Define cutoff values for ridge
cutoffs <- c(0.3, 0.4, 0.5, 0.6, 0.7, 0.8)

# Evaluate Ridge model
ridge.error <- matrix(nrow = length(cutoffs), ncol = 4)
colnames(ridge.error) <- c("cutoff", "Error Rate", "F.Pos Rate", "F.Neg Rate")

for(i in 1:length(cutoffs)){
  ridge.pred <- ifelse(ridge.prob > cutoffs[i], "Y", "N")
  confusion <- table(ridge.pred, High.test)
  error <- 1 - (sum(diag(confusion)) / sum(confusion))
  fpos <- confusion[2,1] / sum(confusion[,1])
  fneg <- confusion[1,2] / sum(confusion[,2])
  
  cat("cutoff =", cutoffs[i], "\n")
  print(confusion)
  cat("Error: ", error, "\n\n") # Misclassification error rate
  
  ridge.error[i, ] <- c(cutoffs[i], error, fpos, fneg)
}

